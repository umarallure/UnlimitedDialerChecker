# /etc/dialer-agent.env  (owner root:dialer-agent, mode 640). Never commit real values.
DIALER_NAME=primary

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

MYSQL_HOST=localhost
MYSQL_USER=udc_ro
MYSQL_PASSWORD=
MYSQL_DATABASE=asterisk

# Temporary: while the carrier dial plan forces a caller ID, VICIdial logs a placeholder (0000000000).
# Set this to the forced number so its calls are counted; remove once the dial plan override is gone.
CID_OVERRIDE=

LIVE_INTERVAL_MS=900000
STATS_INTERVAL_MS=900000
SHORT_CALL_SECONDS=6
RECENT_CALL_DAYS=7
